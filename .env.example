# Copy this file to .env (same folder) and fill in your key. Never commit .env.
#
# Google Gemini (free tier available: create a key at https://aistudio.google.com/apikey)
LLM_PROVIDER=google
GOOGLE_API_KEY=your-gemini-key-here
# Optional: any Gemini chat model your key can use (see https://ai.google.dev/gemini-api/docs/models)
# LLM_MODEL=gemini-3.5-flash

# --- or OpenAI ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your-openai-key-here
# LLM_MODEL=gpt-4.1-mini